{
  "model": "StandardScaler + SVC (scikit-learn Pipeline)",
  "dataset": "UCI Heart Disease, Cleveland Clinic Foundation (303 patients)",
  "input_features": [
    "cp",
    "thalach",
    "oldpeak",
    "exang"
  ],
  "input_ranges": {
    "cp": [
      1,
      4
    ],
    "thalach": [
      71,
      202
    ],
    "oldpeak": [
      0.0,
      6.2
    ],
    "exang": [
      0,
      1
    ]
  },
  "output": {
    "name": "target",
    "0": "no heart disease",
    "1": "heart disease present"
  },
  "best_hyperparameters": {
    "C": 0.5,
    "gamma": 0.01,
    "kernel": "rbf"
  },
  "train_size": 242,
  "test_size": 61,
  "random_state": 42,
  "cv_accuracy": 0.7769,
  "test_metrics": {
    "Accuracy": 0.8197,
    "Precision": 0.8696,
    "Recall (sensitivity)": 0.7143,
    "Specificity": 0.9091,
    "F1-score": 0.7843,
    "ROC-AUC": 0.9253
  },
  "scikit_learn_version": "1.8.0"
}